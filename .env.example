# Copy to .env, protect it (0600), and replace every REPLACE value.
WORMHOLE_IMAGE=ghcr.io/murmuur22/wormhole:0.1.0
WORMHOLE_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
WORMHOLE_ARCHIVE_ID=REPLACE_WITH_32_LOWERCASE_HEX_CHARACTERS
WORMHOLE_STATE_PATH=/srv/wormhole/state
WORMHOLE_ARCHIVE_PATH=/mnt/babel/wormhole
WORMHOLE_UID=10001
WORMHOLE_GID=10001
WORMHOLE_PORTAL_PORT=8751
WORMHOLE_ADMIN_PORT=8752
WORMHOLE_HOSTS=127.0.0.1,localhost
# Keep 1 for HTTPS access. Use 0 only for explicit loopback HTTP testing.
WORMHOLE_SECURE_COOKIES=1
# Set to the exact HTTPS Relay desktop origin when embedding; otherwise leave blank.
WORMHOLE_FRAME_ANCESTOR=
